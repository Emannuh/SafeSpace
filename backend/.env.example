# SafeSpace backend environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Django ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-strong-secret-key-here

# Set to True for local development only. NEVER True in production.
DEBUG=True

# Comma-separated list of allowed hostnames.
# Local default: 127.0.0.1,localhost
# Production example: ALLOWED_HOSTS=safespace.example.com
ALLOWED_HOSTS=127.0.0.1,localhost

# ── HTTPS (production only) ──────────────────────────────────────────────────
# Set to True only when the application is served over HTTPS.
# Enables: SSL redirect, secure cookies, HSTS.
HTTPS=False

# ── Database ─────────────────────────────────────────────────────────────────
# Option A — DATABASE_URL (Railway/Heroku style, takes priority if set):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Option B — individual variables (used if DATABASE_URL is not set):
DB_NAME=safespace
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# ── CORS / CSRF ───────────────────────────────────────────────────────────────
# Comma-separated frontend origins allowed to call the API.
# Production example: CORS_ALLOWED_ORIGINS=https://safespace.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI provider ───────────────────────────────────────────────────────────────
# All AI calls are backend-only. Never expose API keys to the frontend.
# Leave AI_API_KEY empty to run SafeSpace in deterministic-only mode.
AI_PROVIDER=openai
AI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4o-mini
